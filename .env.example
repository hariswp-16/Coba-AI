# ============ APP ============
APP_URL=http://localhost:3000
# Optional single-user password gate (leave empty to disable auth locally)
APP_PASSWORD=
SESSION_SECRET=change-me-to-a-long-random-string

# ============ STORAGE ============
# local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ============ FFMPEG ============
# Resolved automatically from node_modules; override to use a system build
FFMPEG_PATH=
FFPROBE_PATH=

# ============ STORY / LLM ============
# local | openai | anthropic | gemini | openai-compatible
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# ============ IMAGE ============
# local | openai | stability | replicate | fal
IMAGE_PROVIDER=local
IMAGE_MODEL=gpt-image-1
IMAGE_API_KEY=
IMAGE_BASE_URL=

# ============ TTS ============
# local | elevenlabs | openai | google | azure
TTS_PROVIDER=local
TTS_API_KEY=

# ============ VOICE CLONING ============
# none | elevenlabs | fishaudio
VOICE_CLONE_PROVIDER=none
VOICE_CLONE_API_KEY=

# ============ VIDEO GEN (optional) ============
# none | replicate | fal
VIDEO_PROVIDER=none
VIDEO_API_KEY=

# ============ COST CONTROL (USD) ============
COST_IMAGE_PER_SCENE=0.04
COST_TTS_PER_1K_CHARS=0.15
COST_LLM_PER_PROJECT=0.01

# ============ LIMITS ============
MAX_PROJECT_SECONDS=120
MAX_UPLOAD_BYTES=314572800
